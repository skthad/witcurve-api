<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd">
    <changeSet author="WitCurve (generated)" id="1548137795283-1">
        <addColumn tableName="general_slot_details">
            <column name="hours" type="int4" defaultValueNumeric="0"/>
        </addColumn>
    </changeSet>
    <changeSet author="WitCurve (generated)" id="1548137795283-2">
        <addColumn tableName="general_slot_details">
            <column name="minutes" type="int4" defaultValueNumeric="0"/>
        </addColumn>
    </changeSet>
    <changeSet author="WitCurve (generated)" id="1548137795283-3">
        <sql>
            update general_slot_details set minutes =
                case
                    when
                        length(start_time::text) = 3
                    then
                        cast(substring(start_time::text , 2, 2) as integer)
                    else
                        cast(substring(start_time::text, 3,2) as integer)
                    end
        </sql>
        <sql>
            update general_slot_details set hours =
                case
            when
                length(start_time::text) = 3
            then
                cast(substring(start_time::text , 1, 1) as integer)
            else
                cast(substring(start_time::text, 1,2) as integer)
            end
        </sql>
    </changeSet>
    <changeSet author="WitCurve (generated)" id="1548137795283-4">
        <addNotNullConstraint columnDataType="int4" columnName="hours" tableName="general_slot_details"/>
    </changeSet>
    <changeSet author="WitCurve (generated)" id="1548137795283-5">
        <addNotNullConstraint columnDataType="int4" columnName="minutes" tableName="general_slot_details"/>
    </changeSet>
    <changeSet author="WitCurve (generated)" id="1548137795283-6">
        <sql>update general_slot_details set start_time = hours * 100 + minutes</sql>
    </changeSet>
</databaseChangeLog>
